# Copy to .env.local and fill in as each integration is ready.
# Nothing here is required to run the site locally — every value is optional
# and each feature no-ops safely until its variables are set.

# The live domain, once registered/confirmed (Section 11 of the brief).
# Used in metadata, sitemap.xml, and robots.txt. Falls back to
# https://pioneertrioservices.com if unset.
NEXT_PUBLIC_SITE_URL=

# --- Lead delivery (src/lib/lead-notify.ts) ---
# Sends form submissions by email via Gmail SMTP — works today, before the
# business has its own domain (switch to a provider like Resend once you do).
#
# Setup (a few minutes, on the Gmail account you want to send FROM):
#   1. Turn on 2-Step Verification: https://myaccount.google.com/security
#   2. Create an App Password: https://myaccount.google.com/apppasswords
#      (choose "Mail" as the app) — copy the 16-character code it gives you.
#   3. GMAIL_USER is that Gmail address; GMAIL_APP_PASSWORD is the code
#      from step 2 (NOT your normal Gmail password).
GMAIL_USER=
GMAIL_APP_PASSWORD=

# Where leads land. Per-service inboxes (Section 6: Partner A / Partner B
# split) fall back to LEAD_INBOX_EMAIL for any that are unset. Any of these
# can be the same address as GMAIL_USER, or a different one.
IMMIGRATION_INBOX_EMAIL=
MARRIAGE_INBOX_EMAIL=
LEAD_INBOX_EMAIL=

# --- Analytics (src/components/analytics.tsx) ---
# Plausible (https://plausible.io) script domain. Only loads after a visitor
# accepts the cookie consent banner.
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=
